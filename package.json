    "db:seed": "tsx scripts/seed.ts",
    "pipeline:triage": "tsx scripts/pipeline-triage.ts",
    "pipeline:enrich": "tsx scripts/pipeline-enrich.ts",
    "pipeline:cluster": "tsx scripts/pipeline-cluster.ts",
    "estimate": "tsx scripts/estimate.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@base-ui/react": "^1.8.0",
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.14",
    "@langfuse/client": "^5.11.1",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "geist": "^1.7.2",
    "langchain": "^1.5.15",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
