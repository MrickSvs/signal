# Clé API Anthropic (modèles Claude)
ANTHROPIC_API_KEY=
# Clé API Voyage AI (embeddings)
VOYAGE_API_KEY=
# URL du projet Supabase (serveur uniquement)
SUPABASE_URL=
# Clé service role Supabase (serveur uniquement, jamais dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY=
# Connexion Postgres via le pooler Supabase en mode SESSION (port 5432, IPv4) : verrou du pipeline
# et checkpointer LangGraph. Ni la connexion directe (IPv6 seulement) ni le mode transaction (6543).
DATABASE_URL=
# Clé publique Langfuse
LANGFUSE_PUBLIC_KEY=
# Clé secrète Langfuse
LANGFUSE_SECRET_KEY=
# URL de base Langfuse (ex. https://cloud.langfuse.com)
LANGFUSE_BASE_URL=
# Environnement des traces Langfuse (défaut : VERCEL_ENV, sinon development)
LANGFUSE_TRACING_ENVIRONMENT=
# Token de l'intégration interne Notion
NOTION_TOKEN=
# ID de la page parente « Jalon — Produit (Signal) »
NOTION_PARENT_PAGE_ID=
# ID du data source Notion du backlog
NOTION_DS_BACKLOG=
# Mot de passe Basic Auth de l'app déployée (vide = protection désactivée)
SITE_PASSWORD=
# URL publique de l'app, pour les liens poussés dans Notion
APP_BASE_URL=
# Secret des routes cron
CRON_SECRET=
# Date de référence du scénario, ISO 8601 (vide = maintenant)
DEMO_NOW=
